# ============================================================================
# COZY'PLATE – KITCHEN VIBES | ENVIRONMENT CONFIGURATION
# ============================================================================
# Duplicate this file to .env and insert your real credentials.
# NEVER commit your .env file with sensitive passwords to git!
# ============================================================================

# Server Port
PORT=3000

# The Business Owner's Gmail Address (where all customer orders will be delivered)
OWNER_GMAIL=cozyplatekitchen@gmail.com

# ----------------------------------------------------------------------------
# OPTION 1: GMAIL SMTP (Using Gmail App Passwords)
# ----------------------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
GMAIL_USER=your_business_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ----------------------------------------------------------------------------
# OPTION 2: RESEND API (Alternative modern email service)
# ----------------------------------------------------------------------------
# Get your API key at https://resend.com
RESEND_API_KEY=
